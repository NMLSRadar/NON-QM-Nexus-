# NON-QM Nexus environment template.
# Copy to .env.local and fill in values. NEVER commit real secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai
AI_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
RESEND_API_KEY=
FILE_MAX_SIZE_MB=25
SHARED_LINK_SECRET=

# Support / legal contact used across the app (footer, terms, privacy,
# transactional-email reply-to). Falls back to legal@nonqmnexus.com if unset.
SUPPORT_EMAIL=

# Weekly cron auth (see vercel.json + docs on the recheck-guidelines /
# check-citations / trial-emails cron routes).
CRON_SECRET=
# Where citation/guideline-monitor cron alerts are sent. Falls back to the
# platform admin account if unset.
GUIDELINE_MONITOR_ALERT_EMAIL=

# Transactional email — needed for the unsubscribe-link HMAC and the
# CAN-SPAM-required postal address footer.
EMAIL_UNSUBSCRIBE_SECRET=
OWNER_POSTAL_ADDRESS=

# Billing — Stripe (TEST MODE ONLY until the live-mode cutover checklist in
# HANDOFF.md is executed; production has no live Stripe keys).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AE Directory — Featured Placement (docs/team-membership.md's sibling
# monetization surface). AE_MONETIZATION_ENABLED must stay "false" until
# pricing is finalized, regardless of whether a price id is configured.
AE_PLACEMENT_STRIPE_PRICE_ID=
AE_MONETIZATION_ENABLED=false

# Bulk Membership (docs/bulk-membership.md) — inbox that gets notified when
# a new /enterprise quote request comes in. Falls back to the platform
# admin account if unset.
BULK_MEMBERSHIP_NOTIFY_EMAIL=
