// NON-QM Nexus — production database schema (PostgreSQL / Supabase).
//
// ORM decision: Prisma was selected over Drizzle for its mature migration
// tooling, typed client, and first-class PostgreSQL support; see
// docs/architecture.md for the full rationale. The demo app runs on an
// in-memory repository; swapping in a PrismaRepository implements the same
// Repository interface (src/lib/store.ts) without touching UI code.
//
// Multi-tenancy: every tenant-owned row carries organization_id, and
// supabase/rls-policies.sql enables row-level security on all of these
// tables. The Prisma service role connects via a restricted role in
// production; end-user access goes through Supabase with JWT-scoped RLS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  settings      OrganizationSetting[]
  memberships   Membership[]
  lenders       Lender[]
  programs      Program[]
  scenarios     Scenario[]
  auditLogs     AuditLog[]
  aiRequests    AiRequest[]
  featureFlags  FeatureFlag[]
  orgSubscriptions OrgSubscription[]
  orgInvites       OrgInvite[]
  billingEvents  BillingPaymentEvent[]

  @@map("organizations")
}

model OrganizationSetting {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  key            String
  value          Json
  updatedBy      String? @map("updated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@map("organization_settings")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid // mirrors Supabase auth.users id
  email     String   @unique
  platformAdmin Boolean @default(false) @map("platform_admin")
  // Beta tester flag (2026-08-10, supabase/activity-tracking.sql) —
  // orthogonal to trial/paid status: a beta tester can also be trial or
  // paid. Shown as a small secondary chip next to the subscription status.
  isBetaTester Boolean  @default(false) @map("is_beta_tester")
  betaGrantedAt DateTime? @map("beta_granted_at")
  // Stripe customer id — created lazily on first checkout attempt so a user
  // who never subscribes never gets a Stripe customer record.
  stripeCustomerId String? @unique @map("stripe_customer_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  profile      UserProfile?
  memberships  Membership[]
  subscription UserSubscription?
  activityEvents UserActivityEvent[]
  paymentEvents BillingPaymentEvent[]

  @@map("users")
}

model UserProfile {
  userId      String  @id @map("user_id") @db.Uuid
  displayName String? @map("display_name")
  phone       String?
  nmlsId      String? @map("nmls_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

model Membership {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           String // broker | account_executive | processor | underwriter | org_admin | platform_admin
  // True when this member's tier access is covered by the org's team
  // subscription (org_subscriptions) rather than a personal one — see
  // src/lib/repository/membership.ts's getEffectivePlan() resolver and
  // docs/team-membership.md. Toggled by an org_admin, capped by the org
  // subscription's seat_count (enforced both at toggle-time and re-checked
  // in the resolver, oldest-membership-first — see docs/team-membership.md).
  coveredByOrgPlan Boolean @default(false) @map("covered_by_org_plan")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@map("memberships")
}

/// One row per organization's team subscription — a single Stripe (or
/// admin-comped) subscription covering N seats. At most one ACTIVE row per
/// organization (enforced by a partial unique index in
/// supabase/team-membership-schema.sql, since Prisma's schema language has
/// no partial-index syntax) — a canceled row is kept for history when a new
/// one starts. `source` distinguishes a real Stripe subscription from an
/// admin-granted comp (pilot teams — no Stripe object involved), mirroring
/// UserSubscription's own source field. Stripe webhooks are the only writer
/// of Stripe-sourced fields; comped writes go through admin actions with
/// audit_logs entries — see docs/team-membership.md.
model OrgSubscription {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  planId               String    @map("plan_id") @db.Uuid
  seatCount            Int       @map("seat_count")
  status               String    @default("active") // active | canceled
  // stripe | comped | invoiced — "invoiced" added for Bulk Membership
  // (docs/bulk-membership.md): a NET-30 Stripe Invoice, not an ongoing
  // Stripe Subscription object, so it isn't reconciled by the subscription
  // webhooks the way "stripe" rows are — see billingMode/stripeInvoiceId.
  source               String    @default("comped")
  stripeSubscriptionId String?   @unique @map("stripe_subscription_id")
  currentPeriodEnd     DateTime? @map("current_period_end")
  canceledAt           DateTime? @map("canceled_at")
  // --- Bulk Membership fields (2026-07-31, docs/bulk-membership.md) ---
  // All null/default for the 3 existing self-serve tiers' org subscriptions
  // (billingMode stays "standard"). Set only when planId points at the
  // "bulk_enterprise" plan, whose price is negotiated per deal rather than
  // fixed on the plan row.
  // "standard" (existing 3-tier team pricing) | "custom_stripe" (dynamic
  // per-deal Stripe Price, real subscription, card-billed) | "invoiced"
  // (NET-30 Stripe Invoice, no subscription object).
  billingMode             String   @default("standard") @map("billing_mode")
  // Negotiated $/seat/month in cents for this specific deal — informational
  // once a custom_stripe Price is created (the Price itself is the source of
  // truth for what's actually charged), and the ONLY source of truth for an
  // "invoiced" row (used to compute each invoice's line-item amount).
  customPricePerSeatCents Int?      @map("custom_price_per_seat_cents")
  // Set only for billingMode = "invoiced". The most recently sent Stripe
  // Invoice id, and when the NEXT one is due — there is no recurring Stripe
  // object for an invoiced deal, so "renew" is a manual admin action
  // (src/app/admin/bulk-memberships/actions.ts's sendNextBulkInvoice()).
  stripeInvoiceId      String?   @map("stripe_invoice_id")
  nextInvoiceDueAt     DateTime? @map("next_invoice_due_at")
  // Who to bill / contact for this org's bulk deal — the negotiating
  // contact, not necessarily any one covered member.
  billingContactEmail  String?   @map("billing_contact_email")
  billingContactName   String?   @map("billing_contact_name")
  // --- Payment-decline (dunning) tracking (2026-08-16, docs/billing-runbook.md) ---
  // Mirrors UserSubscription's dunning fields for team subscriptions. Written
  // only by the Stripe webhook (invoice.payment_failed / payment_succeeded)
  // and the daily billing-dunning cron. Team failure state is informational
  // (the org's covered members keep access until the sub is actually
  // canceled); the personal dunning columns are the ones gating access.
  lastPaymentFailedAt    DateTime? @map("last_payment_failed_at")
  lastPaymentSucceededAt DateTime? @map("last_payment_succeeded_at")
  nextPaymentAttemptAt   DateTime? @map("next_payment_attempt_at")
  declineCount           Int       @default(0) @map("decline_count")
  dunningEmailCount      Int       @default(0) @map("dunning_email_count")
  lastDunningEmailSentAt DateTime? @map("last_dunning_email_sent_at")
  cancelRequestedAt      DateTime? @map("cancel_requested_at")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  plan         MembershipPlan  @relation(fields: [planId], references: [id])

  @@map("org_subscriptions")
}

/// An inbound lead from the public "Request Bulk Membership" page
/// (src/app/enterprise) — captured before any pricing is negotiated. An
/// admin reviews it in /admin/bulk-memberships and either converts it into
/// a real OrgSubscription (status -> "converted", convertedOrganizationId
/// set) or declines it. Purely a sales-intake record — never grants access
/// on its own.
model BulkMembershipRequest {
  id                     String    @id @default(uuid()) @db.Uuid
  companyName            String    @map("company_name")
  contactName            String    @map("contact_name")
  contactEmail           String    @map("contact_email")
  contactPhone           String?   @map("contact_phone")
  seatCountRequested      Int      @map("seat_count_requested")
  notes                  String?
  status                 String    @default("new") // new | contacted | converted | declined
  convertedOrganizationId String?  @map("converted_organization_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("bulk_membership_requests")
}

/// A pending (or resolved) invitation for a user to join an organization's
/// team. Only the SHA-256 hash of the raw token is ever stored — the raw
/// token exists exactly once, in the invite email/link — same convention as
/// SharedLink.tokenHash. Single-use: accepted_at or revoked_at, once set,
/// permanently retires the invite (see docs/team-membership.md).
model OrgInvite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  role           String
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  invitedBy      String    @map("invited_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("org_invites")
}

model Lender {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  isSampleData   Boolean @default(false) @map("is_sample_data")
  active         Boolean @default(true)
  contactEmail   String? @map("contact_email")
  notes          String?
  // Minimum subscription tier (1, 2, or 3) required to see this lender in
  // comparisons. 1 = Essential (Top 12), 2 = Professional (Top 25),
  // 3 = Enterprise (unlimited). New lenders default to 3 so they only
  // surface for Enterprise until an admin explicitly curates them into the
  // Top 12 / Top 25 lists (see docs/membership.md).
  tierLevel      Int     @default(3) @map("tier_level")
  createdBy      String? @map("created_by") @db.Uuid
  // AE Directory (2026-07-30, supabase/ae-directory.sql) — admin-maintained
  // verified email domain, used ONLY to auto-approve an AE claim when
  // their verified auth email matches. Never eligibility-related.
  emailDomain    String? @map("email_domain")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  programs     Program[]
  documents    Document[]
  aeProfiles   AeProfile[]

  @@map("lenders")
}

/// A subscription tier. Fully admin-managed — name, price, and the lender
/// tier level it unlocks can all change without a code deploy. New tiers
/// can be added by inserting another row (see src/app/admin/plans).
model MembershipPlan {
  id                String   @id @default(uuid()) @db.Uuid
  key               String   @unique // stable code reference, e.g. "essential"
  name              String
  monthlyPriceCents Int      @map("monthly_price_cents")
  // Annual price in cents (billed once per year) — null means this plan has
  // no annual option configured yet. A plain override rather than a
  // computed discount, so admins can set any annual price they want; the
  // pricing UI's "Save 20%" copy is presentation, not enforced math.
  annualPriceCents  Int?     @map("annual_price_cents")
  // The lender tier level this plan unlocks (see Lender.tierLevel): a user
  // on a plan with tierLevel N can see any lender with tierLevel <= N.
  tierLevel         Int      @map("tier_level")
  description       String?
  isActive          Boolean  @default(true) @map("is_active")
  sortOrder         Int      @default(0) @map("sort_order")
  // Stripe recurring Price id for this plan's monthly subscription
  // (set by scripts/stripe-setup-products.js). Null for a plan that has no
  // live Stripe price yet (e.g. before setup, or a comp-only plan).
  stripePriceId     String?  @unique @map("stripe_price_id")
  // Stripe recurring Price id for this plan's annual subscription (20% off
  // the monthly*12 equivalent, by convention — see scripts/stripe-annual-
  // billing.js). Null until an annual price has been created for this plan.
  stripeAnnualPriceId String? @unique @map("stripe_annual_price_id")
  // Per-seat (licensed quantity billing) team Price ids for
  // org_subscriptions checkout — Stripe's native tiered pricing handles
  // volume discounts on these, so there's exactly one Price id per
  // interval (see scripts/stripe-team-billing.js). Null until team billing
  // has been set up for this plan.
  stripeTeamPriceId       String? @unique @map("stripe_team_price_id")
  stripeTeamAnnualPriceId String? @unique @map("stripe_team_annual_price_id")
  // Underlying Stripe Product id — the 3 self-serve tiers derive their
  // product from their own stripePriceId (see scripts/stripe-team-billing.js),
  // so this is null for them. Set only for the "bulk_enterprise" plan (see
  // docs/bulk-membership.md), whose per-deal Prices are created dynamically
  // at negotiation time and need a shared Product to attach to.
  stripeProductId   String?  @map("stripe_product_id")
  amountCents       Int?     @map("amount_cents")
  billingMode       String?  @map("billing_mode")
  termMonths        Int?     @map("term_months")
  rollsToPlanKey    String?  @map("rolls_to_plan_key")
  cancellableMidTerm Boolean? @map("cancellable_mid_term")
  stripeLookupKey   String?  @unique @map("stripe_lookup_key")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  subscriptions UserSubscription[]
  orgSubscriptions OrgSubscription[]

  @@map("membership_plans")
}

/// A reusable discount definition (e.g. "50% Off", "100% Off"). Admins can
/// add more percentages later without a migration — this is just data.
model Discount {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  percentOff Int      @map("percent_off") // 0-100
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  subscriptions UserSubscription[]

  @@map("discounts")
}

/// One row per user: their current plan and an optional active discount.
/// Admin-assigned for now (no self-serve checkout / billing yet — see
/// FINALIZE.md Phase 7 for the future Stripe integration). A discount stays
/// in effect until an admin removes it (sets discountId back to null).
/// canceledAt: set when the user self-cancels (or an admin cancels on their
/// behalf) — the plan/discount are kept for history, but a canceled
/// subscription grants no lender-tier access (see getEffectivePlan()).
/// Reactivating (by an admin) just clears canceledAt back to null.
model UserSubscription {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  planId       String?   @map("plan_id") @db.Uuid
  discountId   String?   @map("discount_id") @db.Uuid
  assignedBy   String?   @map("assigned_by") @db.Uuid // platform admin who set this
  startedAt    DateTime  @default(now()) @map("started_at")
  canceledAt   DateTime? @map("canceled_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Live billing (Stripe Checkout + Billing). `source` distinguishes a real
  // paid subscription from an admin-granted comp (free/discounted access
  // with no Stripe object behind it) — see docs/billing.md. Stripe webhooks
  // are the only writer of stripeStatus / currentPeriodEnd; this app never
  // guesses subscription state from client-side signals.
  source             String    @default("comped") @map("source") // stripe | comped
  stripeCustomerId   String?   @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripeStatus       String?   @map("stripe_status") // active | trialing | past_due | canceled | incomplete | ...
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  // "monthly" | "annual" — which recurring price the active Stripe
  // subscription is actually billed on (or "monthly" by default for a
  // comped/admin-assigned plan, which has no real interval). Written by the
  // Stripe webhook from the subscription's own price, never guessed.
  billingInterval    String    @default("monthly") @map("billing_interval")

  // 14-Day Loan Officer Testing Access trial state (2026-07-28,
  // supabase/trial-access.sql) — a trial IS a subscription row (pointed at
  // Enterprise) rather than a separate concept, so getEffectivePlan() stays
  // the single source of truth for tier resolution. trialExpiresAt is the
  // SOLE, server-computed source of truth for expiration (see
  // src/lib/repository/membership.ts) — never derived from client input.
  isTrial            Boolean   @default(false) @map("is_trial")
  trialActivatedAt   DateTime? @map("trial_activated_at")
  trialExpiresAt     DateTime? @map("trial_expires_at")

  // --- Payment-decline (dunning) tracking (2026-08-16, docs/billing-runbook.md) ---
  // Written ONLY by the Stripe webhook (invoice.payment_failed /
  // invoice.payment_succeeded) and by the daily billing-dunning cron that
  // sends the follow-up email. declineCount is the cumulative number of
  // failed payment attempts Stripe reported for this subscription; it is
  // reset to 0 the moment a payment succeeds — so a nonzero value with a
  // recent lastPaymentFailedAt means "currently in dunning".
  lastPaymentFailedAt    DateTime? @map("last_payment_failed_at")
  lastPaymentSucceededAt DateTime? @map("last_payment_succeeded_at")
  nextPaymentAttemptAt   DateTime? @map("next_payment_attempt_at")
  declineCount           Int       @default(0) @map("decline_count")
  dunningEmailCount      Int       @default(0) @map("dunning_email_count")
  lastDunningEmailSentAt DateTime? @map("last_dunning_email_sent_at")
  // When the member ASKED to cancel (retention: voluntary churn intent).
  // Distinct from canceled_at, which is when access actually ends. A
  // cancel_at_period_end user keeps cancel_requested_at NULL until the
  // webhook sees a cancel request — see docs/billing-runbook.md.
  cancelRequestedAt DateTime? @map("cancel_requested_at")

  pricingVersion             String?   @map("pricing_version")
  amountCents                Int?      @map("amount_cents")
  billingMode                String?   @map("billing_mode")
  termMonths                 Int?      @map("term_months")
  rollsToPlanId              String?   @map("rolls_to_plan_id")
  legacyPlanKey              String?   @map("legacy_plan_key")
  commitmentAckText          String?   @map("commitment_ack_text")
  commitmentAckVersion       String?   @map("commitment_ack_version")
  commitmentAckAt            DateTime? @map("commitment_ack_at")
  commitmentAckIp            String?   @map("commitment_ack_ip")
  commitmentAckUserAgent     String?   @map("commitment_ack_user_agent")
  commitmentCheckoutSessionId String?  @unique @map("commitment_checkout_session_id")
  cancelAtCommitmentEnd      Boolean   @default(false) @map("cancel_at_commitment_end")

  user     User            @relation(fields: [userId], references: [id])
  plan     MembershipPlan? @relation(fields: [planId], references: [id])
  discount Discount?       @relation(fields: [discountId], references: [id])

  @@map("user_subscriptions")
}

/// One row per Stripe billing event we care about (2026-08-16,
/// docs/billing-runbook.md). This is the event-trail table that powers the
/// admin Billing & Retention dashboard: every failed payment attempt,
/// every successful recovery, and every membership start / cancel request /
/// actual cancel lands here with the Stripe reason + attempt payload. It is
/// append-only by convention — the webhook inserts, never updates.
/// `userId` is set for personal subscriptions, `organizationId` for team
/// (org_subscriptions) rows; exactly one is populated.
model BillingPaymentEvent {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String?   @map("user_id") @db.Uuid
  organizationId      String?   @map("organization_id") @db.Uuid
  eventType           String    @map("event_type")
  // payment_failed | payment_succeeded | membership_started | membership_canceled
  // | cancel_requested (cancel at period end) | cancel_revoked
  stripeEventId       String    @unique @map("stripe_event_id") // Stripe event.id — dedupes webhook redelivery
  stripeCustomerId    String?   @map("stripe_customer_id")
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  amountCents         Int?      @map("amount_cents")
  attemptNumber       Int?      @map("attempt_number") // Stripe invoice.attempt_count for failures
  failureCode         String?   @map("failure_code") // e.g. card_declined, expired_card
  failureMessage      String?   @map("failure_message")
  nextRetryAt         DateTime? @map("next_retry_at") // invoice.next_payment_attempt
  createdAt           DateTime  @default(now()) @map("created_at")

  user          User?          @relation(fields: [userId], references: [id])
  organization  Organization?  @relation(fields: [organizationId], references: [id])

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([stripeSubscriptionId])
  @@index([eventType, createdAt])
  @@map("billing_payment_events")
}

model Program {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  lenderId       String  @map("lender_id") @db.Uuid
  name           String
  isSampleData   Boolean @default(false) @map("is_sample_data")
  active         Boolean @default(true)
  // Program constraint configuration (see src/domain/types/program.ts)
  config         Json
  createdBy      String? @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  version        Int      @default(1) // optimistic concurrency

  organization      Organization       @relation(fields: [organizationId], references: [id])
  lender            Lender             @relation(fields: [lenderId], references: [id])
  guidelineVersions GuidelineVersion[]
  rules             Rule[]

  @@map("programs")
}

model GuidelineVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  programId          String    @map("program_id") @db.Uuid
  label              String
  effectiveDate      DateTime  @map("effective_date") @db.Date
  expirationDate     DateTime? @map("expiration_date") @db.Date
  lastVerifiedDate   DateTime? @map("last_verified_date") @db.Date
  verificationStatus String    @map("verification_status") // human_verified | imported_pending_review | ai_extracted_pending_review | draft | archived | superseded
  publishedAt        DateTime? @map("published_at")
  reviewedBy         String?   @map("reviewed_by") @db.Uuid
  sourceDocumentId   String?   @map("source_document_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Automated re-check monitoring (see docs/guideline-monitoring.md): the
  // public URL this guideline came from, a hash of its last-fetched content,
  // when it was last checked, and whether the last check found a change.
  sourceUrl       String?   @map("source_url")
  contentHash     String?   @map("content_hash")
  lastCheckedAt   DateTime? @map("last_checked_at")
  changeDetected  Boolean   @default(false) @map("change_detected")

  program Program @relation(fields: [programId], references: [id])
  rules   Rule[]

  @@map("guideline_versions")
}

model Rule {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  programId          String    @map("program_id") @db.Uuid
  guidelineVersionId String    @map("guideline_version_id") @db.Uuid
  category           String
  name               String
  // Nested AND/OR condition tree + outcomes (see src/domain/types/program.ts)
  definition         Json
  severity           String // hard | soft | info
  userExplanation    String    @map("user_explanation")
  internalExplanation String?  @map("internal_explanation")
  sourceSection      String?   @map("source_section")
  sourcePage         Int?      @map("source_page")
  effectiveDate      DateTime? @map("effective_date") @db.Date
  expirationDate     DateTime? @map("expiration_date") @db.Date
  verificationStatus String    @map("verification_status")
  createdBy          String?   @map("created_by") @db.Uuid
  reviewedBy         String?   @map("reviewed_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  program          Program          @relation(fields: [programId], references: [id])
  guidelineVersion GuidelineVersion @relation(fields: [guidelineVersionId], references: [id])

  @@map("rules")
}

model Scenario {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdBy      String   @map("created_by") @db.Uuid
  // Full normalized scenario payload (see src/domain/types/scenario.ts).
  // Individually queried fields are also projected into columns as needed.
  data           Json
  status         String   @default("draft") // draft | analyzed | archived
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  version        Int      @default(1)

  organization Organization  @relation(fields: [organizationId], references: [id])
  documents    Document[]
  evaluations  ProgramEvaluationRecord[]
  reports      Report[]
  sharedLinks  SharedLink[]

  @@index([organizationId, updatedAt])
  @@map("scenarios")
}

model Document {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scenarioId     String?  @map("scenario_id") @db.Uuid
  // Set for an admin-uploaded lender guideline/matrix PDF (see
  // supabase/lender-documents-storage.sql); null for a scenario-attached
  // borrower document (bank statement, P&L, ...).
  lenderId       String?  @map("lender_id") @db.Uuid
  storagePath    String   @map("storage_path") // Supabase Storage object path
  fileName       String   @map("file_name")
  mimeType       String   @map("mime_type")
  sizeBytes      Int      @map("size_bytes")
  classification String? // bank_statement | pnl | appraisal | lender_guideline | ...
  uploadedBy     String   @map("uploaded_by") @db.Uuid
  virusScanned   Boolean  @default(false) @map("virus_scanned")
  createdAt      DateTime @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")

  scenario    Scenario?           @relation(fields: [scenarioId], references: [id])
  lender      Lender?             @relation(fields: [lenderId], references: [id])
  extractions DocumentExtraction[]

  @@map("documents")
}

model DocumentExtraction {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  documentId     String   @map("document_id") @db.Uuid
  extractor      String // manual | ai:anthropic | ai:openai | ocr:...
  // Extracted fields with provenance (page, confidence); kept separate from
  // source files. Values require user confirmation before affecting eligibility.
  fields         Json
  confirmedBy    String?  @map("confirmed_by") @db.Uuid
  confirmedAt    DateTime? @map("confirmed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id])

  @@map("document_extractions")
}

model ProgramEvaluationRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scenarioId     String   @map("scenario_id") @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  // Full evaluation snapshot: status, score, rule results, guideline version.
  result         Json
  evaluatedAt    DateTime @default(now()) @map("evaluated_at")

  scenario Scenario @relation(fields: [scenarioId], references: [id])

  @@index([organizationId, scenarioId])
  @@map("program_evaluations")
}

model Report {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scenarioId     String   @map("scenario_id") @db.Uuid
  kind           String // pdf | html | csv | json
  storagePath    String?  @map("storage_path")
  generatedBy    String   @map("generated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  scenario Scenario @relation(fields: [scenarioId], references: [id])

  @@map("reports")
}

model SharedLink {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  scenarioId     String   @map("scenario_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash") // never store the raw token
  expiresAt      DateTime @map("expires_at")
  createdBy      String   @map("created_by") @db.Uuid
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime @default(now()) @map("created_at")

  scenario Scenario @relation(fields: [scenarioId], references: [id])

  @@map("shared_links")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String // e.g. scenario.create, rule.publish, program.deactivate
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  // Metadata only — no borrower PII in audit payloads.
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

model AiRequest {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  scenarioId     String?  @map("scenario_id") @db.Uuid
  provider       String
  model          String
  promptVersion  String   @map("prompt_version")
  // Deterministic facts supplied to the model (for audit), response, and
  // whether the user accepted/edited the output. No secrets, minimal PII.
  factsSupplied  Json?    @map("facts_supplied")
  response       String?
  accepted       Boolean? // null = pending user decision
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("ai_requests")
}

model FeatureFlag {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid // null = platform-wide
  key            String
  enabled        Boolean @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@map("feature_flags")
}

// ---------------------------------------------------------------------------
// 14-Day Loan Officer Testing Access — trial campaigns (2026-07-28, see
// supabase/trial-access.sql / trial-email-tracking.sql for the full spec).
// Platform-wide (not organization-scoped) — a trial campaign is a
// promotional link, not tenant data.
// ---------------------------------------------------------------------------
model TrialCampaign {
  id                            String    @id @default(uuid()) @db.Uuid
  name                          String
  description                   String?
  slug                          String    @unique
  isActive                      Boolean   @default(true) @map("is_active")
  trialDurationDays             Int       @default(14) @map("trial_duration_days")
  maxRedemptions                Int?      @map("max_redemptions")
  startsAt                      DateTime? @map("starts_at")
  endsAt                        DateTime? @map("ends_at")
  allowedEmailDomains           String[]  @map("allowed_email_domains")
  requireOneRedemptionPerEmail  Boolean   @default(true) @map("require_one_redemption_per_email")
  requireNmlsNumber             Boolean   @default(false) @map("require_nmls_number")
  requireCompanyName            Boolean   @default(false) @map("require_company_name")
  createdBy                     String?   @map("created_by") @db.Uuid
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  @@map("trial_campaigns")
}

/// One row per user who activated a trial. campaignId has no Prisma
/// @relation (matches this schema's existing convention for created_by/
/// reviewed_by-style FK columns — see Lender.createdBy etc.) since it's
/// only ever queried directly, never joined through Prisma Client.
model TrialRedemption {
  id                          String    @id @default(uuid()) @db.Uuid
  campaignId                  String    @map("campaign_id") @db.Uuid
  userId                      String    @unique @map("user_id") @db.Uuid
  email                       String
  normalizedEmail             String    @map("normalized_email")
  firstName                   String?   @map("first_name")
  lastName                    String?   @map("last_name")
  companyName                 String?   @map("company_name")
  nmlsNumber                  String?   @map("nmls_number")
  state                       String?
  activatedAt                 DateTime  @default(now()) @map("activated_at")
  expiresAt                   DateTime  @map("expires_at")
  revokedAt                   DateTime? @map("revoked_at")
  extendedBy                  String?   @map("extended_by") @db.Uuid
  extensionCount              Int       @default(0) @map("extension_count")
  convertedAt                 DateTime? @map("converted_at")
  convertedPlanKey            String?   @map("converted_plan_key")
  lastLoginAt                 DateTime? @map("last_login_at")
  scenariosSubmittedCount     Int       @default(0) @map("scenarios_submitted_count")
  lenderComparisonsCount      Int       @default(0) @map("lender_comparisons_count")
  voiceScenariosSubmittedCount Int      @default(0) @map("voice_scenarios_submitted_count")
  // Email idempotency tracking (supabase/trial-email-tracking.sql) — one
  // timestamp per email type, so the scheduled sweep never double-sends.
  activationEmailSentAt       DateTime? @map("activation_email_sent_at")
  midTrialEmailSentAt         DateTime? @map("mid_trial_email_sent_at")
  expirationReminderSentAt    DateTime? @map("expiration_reminder_sent_at")
  expirationEmailSentAt       DateTime? @map("expiration_email_sent_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  @@map("trial_redemptions")
}

/// One row per pending/issued trial beta-invite (supabase/trial-invite-tokens.sql).
/// An app-generated token link (…?token=<raw>) whose SHA-256 hash is stored here;
/// the invite-accept page validates it server-side via the service-role client.
/// campaignId has no Prisma @relation (same created_by/FK convention as above) —
/// always queried directly, never joined through Prisma Client.
model TrialInvite {
  id              String    @id @default(uuid()) @db.Uuid
  campaignId      String    @map("campaign_id") @db.Uuid
  email           String
  normalizedEmail String    @map("normalized_email")
  tokenHash       String    @unique @map("token_hash")
  createdBy       String?   @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")

  @@map("trial_invites")
}

// ---------------------------------------------------------------------------
// Citation-link monitoring (see supabase/citation-link-checks.sql) —
// operational state for the weekly citation-check cron, not tenant data.
// ---------------------------------------------------------------------------
model CitationLinkCheck {
  url            String    @id
  lastStatus     Int?      @map("last_status")
  lastCheckedAt  DateTime  @default(now()) @map("last_checked_at")
  isBroken       Boolean   @default(false) @map("is_broken")
  firstBrokenAt  DateTime? @map("first_broken_at")
  lastError      String?   @map("last_error")

  @@map("citation_link_checks")
}

// ---------------------------------------------------------------------------
// AE Directory, Sponsored Placement & Outreach System (2026-07-30, see
// supabase/ae-directory.sql). RESPA Section 8 conservative design — flat
// monthly subscription for placement only, never read by the matching
// engine. Platform-wide (lender-scoped, not organization-scoped).
// ---------------------------------------------------------------------------
model AeProfile {
  id               String   @id @default(uuid()) @db.Uuid
  lenderId         String   @map("lender_id") @db.Uuid
  name             String
  title            String?
  email            String
  phone            String?
  nmlsId           String?  @map("nmls_id")
  states           String[] @default([])
  photoUrl         String?  @map("photo_url")
  claimedByUserId  String?  @map("claimed_by_user_id") @db.Uuid
  status           String   @default("unclaimed") // unclaimed | claimed | hidden
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  lender     Lender      @relation(fields: [lenderId], references: [id])
  events     AeProfileEvent[]
  placement  AePlacement?

  @@map("ae_profiles")
}

model AeProfileEvent {
  id          String   @id @default(uuid()) @db.Uuid
  aeProfileId String   @map("ae_profile_id") @db.Uuid
  event       String // view | click_phone | click_email
  createdAt   DateTime @default(now()) @map("created_at")

  aeProfile AeProfile @relation(fields: [aeProfileId], references: [id])

  @@map("ae_profile_events")
}

model AePlacement {
  id                   String    @id @default(uuid()) @db.Uuid
  aeProfileId          String    @unique @map("ae_profile_id") @db.Uuid
  status               String    @default("none") // none | active | canceled
  source               String? // stripe | comped
  stripeCustomerId     String?   @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  startedAt            DateTime? @map("started_at")
  canceledAt           DateTime? @map("canceled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  aeProfile AeProfile @relation(fields: [aeProfileId], references: [id])

  @@map("ae_placements")
}

model OutreachContact {
  id               String    @id @default(uuid()) @db.Uuid
  aeProfileId      String?   @map("ae_profile_id") @db.Uuid
  name             String
  email            String
  lenderName       String    @map("lender_name")
  sourceNote       String?   @map("source_note")
  status           String    @default("prospect") // prospect | invited | claimed | subscribed | unsubscribed
  lastContactedAt  DateTime? @map("last_contacted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sends OutreachSend[]

  @@map("outreach_contacts")
}

model EmailSuppression {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  reason    String   @default("unsubscribed")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_suppressions")
}

model OutreachSend {
  id                String   @id @default(uuid()) @db.Uuid
  outreachContactId String?  @map("outreach_contact_id") @db.Uuid
  template          String
  recipientEmail    String   @map("recipient_email")
  triggeredBy       String?  @map("triggered_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  outreachContact OutreachContact? @relation(fields: [outreachContactId], references: [id])

  @@map("outreach_sends")
}

// ---------------------------------------------------------------------------
// Trigger observability (incident 2026-07-30 hardening, 2026-08-05) —
// handle_new_user()'s invite-branch EXCEPTION WHEN OTHERS handler
// (supabase/team-invite-signup.sql) used to swallow errors invisibly and
// silently fall through to normal (self-org) signup. It now also inserts a
// row here (in addition to RAISE WARNING) so a corrupted/erroring invite
// path is observable after the fact. Never stores the full email — only
// the domain, so this table carries no direct PII.
// ---------------------------------------------------------------------------
model SignupTriggerError {
  id              String   @id @default(uuid()) @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at")
  sqlstate        String
  message         String
  emailDomainOnly String?  @map("email_domain_only")

  @@map("signup_trigger_errors")
}

// ---------------------------------------------------------------------------
// Activity & beta-testing analytics (2026-08-10, supabase/activity-tracking.sql).
// ONE table feeds the entire /admin/activity "Active Users & Beta Testers"
// screen: last login, last activity, total logins, scenario count, features
// used, days idle, top feature are all DERIVED from this table (via the
// user_activity_summary / user_activity_timeline views) — never stored in
// per-feature columns. Every row joins to the existing users.id.
// ---------------------------------------------------------------------------
model UserActivityEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  // login | scenario_submitted | voice_scenario | ai_assistant |
  // lender_list | programs | doc_needs | products
  eventType  String   @map("event_type")
  occurredAt DateTime @default(now()) @map("occurred_at")
  metadata   Json?    @db.Json

  user User @relation(fields: [userId], references: [id])

  @@index([userId, occurredAt])
  @@index([occurredAt])
  @@map("user_activity_events")
}
// Beta Tester Feedback — see supabase/beta-feedback.sql for the authoritative
// DDL, RLS, and the ensure_beta_survey_for_me() SECURITY DEFINER created here.
// One row per user (unique user_id = "no duplicate surveys"). trial_started_at
// is the exact trial start date (copied from trial_redemptions.activated_at)
// and is the ONLY basis for the Day-3 / Day-5 automation timing. responses is
// JSONB { question_id: value } autosaved incrementally so a partially-completed
// survey resumes where it left off. day3_email_id / (day5_follow_up_sent_at +
// day5_email_id) are idempotency markers so a repeated cron never double-sends.
// Prisma mirror only — the app writes via the Supabase service client.
// ---------------------------------------------------------------------------
model BetaTesterSurvey {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  trialRedemptionId    String?  @unique @map("trial_redemption_id") @db.Uuid
  trialStartedAt       DateTime @map("trial_started_at")
  status               String   @default("NOT_SENT")
  token                String   @unique
  day3EmailSentAt      DateTime? @map("day3_email_sent_at")
  day3EmailId          String?  @map("day3_email_id")
  openedAt             DateTime? @map("opened_at")
  startedAt            DateTime? @map("started_at")
  lastAnsweredAt       DateTime? @map("last_answered_at")
  completedAt          DateTime? @map("completed_at")
  completionPercentage Int      @default(0) @map("completion_percentage")
  day5FollowUpSentAt   DateTime? @map("day5_follow_up_sent_at")
  day5EmailId          String?  @map("day5_email_id")
  responses            Json     @default("{}")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("beta_tester_surveys")

}

// ---------------------------------------------------------------------------
// Signup Attribution (2026-08-16, supabase/signup-attribution.sql,
// docs/tasks/03-signup-attribution.md). Written ONLY via the Supabase service
// client / SECURITY DEFINER resolver (resolve_attribution_for_signup); RLS is
// platform-admin-only, so a member-role session sees zero rows. Task 04
// (Membership Management) reads these tables for per-rep retention.
// ---------------------------------------------------------------------------
model SalesRep {
